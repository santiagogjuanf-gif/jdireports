# ================================================
# VARIABLES DE ENTORNO - JD CLEANING SERVICES
# ================================================
# Copia este archivo a .env y completa los valores
# Windows PowerShell: Copy-Item .env.example .env
# Windows CMD: copy .env.example .env
# Linux/Mac: cp .env.example .env

# ================================================
# BASE DE DATOS (MySQL)
# ================================================
# CONFIGURACIÓN PARA XAMPP (Windows):
# - DB_USER por defecto es 'root'
# - DB_PASSWORD por defecto está VACÍO (déjalo sin nada si no configuraste password)
# - DB_NAME debe crearse primero en phpMyAdmin o con comando SQL
# 
# CONFIGURACIÓN PARA Linux/Ubuntu:
# - Ajusta DB_USER y DB_PASSWORD según tu configuración de MySQL

DB_HOST=localhost
DB_PORT=3306
DB_NAME=jd_cleaning_services
DB_USER=root
DB_PASSWORD=

# ================================================
# SERVIDOR
# ================================================
PORT=3000
NODE_ENV=production

# ================================================
# JWT (AUTENTICACIÓN)
# ================================================
# Genera un secret seguro con:
# Windows PowerShell/CMD: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Linux/Mac: openssl rand -hex 32
JWT_SECRET=CAMBIA_ESTE_SECRET_POR_UNO_GENERADO_ALEATORIAMENTE
JWT_EXPIRES_IN=24h

# ================================================
# CORS
# ================================================
# Dominio permitido para acceder a la API
# '*' permite todos los dominios (útil para desarrollo)
# En producción, especifica tu dominio exacto: https://tudominio.com
CORS_ORIGIN=*

# ================================================
# EMAIL (NODEMAILER)
# ================================================
# Para usar Gmail:
# 1. Habilita verificación en 2 pasos en tu cuenta Gmail
# 2. Genera una contraseña de aplicación (16 dígitos sin espacios)
# 3. Usa esa contraseña aquí (NO tu contraseña normal de Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_email@gmail.com
EMAIL_PASSWORD=tu_password_de_aplicacion_de_16_digitos
EMAIL_FROM=noreply@jdcleaning.com

# ================================================
# CLOUDFLARE (OPCIONAL)
# ================================================
# Si usas Cloudflare Tunnel, estas variables son opcionales
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# ================================================
# RATE LIMITING
# ================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================================
# UPLOADS
# ================================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ================================================
# LOGS
# ================================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log
